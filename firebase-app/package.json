{
  "name": "yaguking-firebase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "야구왕 — Firebase Spark(무료) 전용 판. Supabase·Vercel·Cloud Functions를 쓰지 않는다.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/subset-font.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "emulators": "firebase emulators:start --project demo-yaguking",
    "test:rules": "firebase emulators:exec --only firestore --project demo-yaguking \"vitest run tests/rules\"",
    "test:e2e": "playwright test",
    "emulators:auth": "firebase emulators:start --only auth --project demo-yaguking",
    "content:build": "node scripts/build-questions.mjs",
    "font:subset": "node scripts/subset-font.mjs",
    "usage:measure": "cross-env USAGE_REPORT=docs/usage-measured.json playwright test tests/e2e/usage.spec.ts --project=sm-360",
    "usage:transfer": "cross-env VITE_USE_EMULATORS=true npm run build && firebase emulators:exec --only auth,firestore --project demo-yaguking \"node scripts/measure-transfer.mjs\"",
    "test:ops": "firebase emulators:exec --only auth,firestore --project demo-yaguking \"vitest run tests/ops\"",
    "deploy:check": "node scripts/predeploy-check.mjs",
    "ops:cleanup": "node ops/cleanup-cli.mjs"
  },
  "dependencies": {
    "firebase": "13.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@firebase/rules-unit-testing": "6.0.0",
    "@fontsource/jua": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "cross-env": "10.1.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.34.1",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
