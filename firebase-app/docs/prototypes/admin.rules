rules_version = '2';

// 관리자 기획(docs/admin-plan.md §2)의 **시험용 규칙** — 배포하지 않는다.
// 확인할 가정: 1) 토큰의 admin 표시로만 관리자 권한이 열린다(이메일만 같아서는 안 됨)
// 2) 관리자는 컬렉션 묶음(games) 집계·목록을 할 수 있고 일반 이용자는 못 한다
// 3) 관리자 기록은 만들기만, 서버 시각·작성자 본인 강제 4) 공개 문서는 누구나 읽고 관리자만 쓴다
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true
        && request.auth.token.get('email_verified', false) == true;
    }

    match /users/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow delete: if isSelf(uid) || isAdmin();
      match /games/{id} {
        allow read: if isSelf(uid) || isAdmin();
        allow delete: if isSelf(uid) || isAdmin();
      }
    }

    // 통계: 모든 사람의 경기를 묶어 집계 — 관리자만
    match /{path=**}/games/{id} {
      allow list: if isAdmin();
    }

    match /adminLogs/{id} {
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['by', 'action', 'target', 'detail', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /adminTasks/{id} {
      allow create: if isAdmin() && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false; // 처리는 Admin SDK(운영자 PC)
    }

    match /public/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
