rules_version = '2';

// 야구왕 Firebase판 보안 규칙.
//
// 무료(Spark) 플랜에는 서버 코드가 없다. **이 규칙이 유일한 서버 쪽 방어선이다.**
// 여기 없는 경로는 기본으로 모두 막힌다. 규칙을 바꾸면 tests/rules/의 에뮬레이터
// 테스트를 함께 고친다.
//
// 1단계: users/{uid} — 회원 프로필과 만 14세 확인. 나머지 컬렉션은 2단계에서 연다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 익명 로그인(비회원)이 아닌 회원
    function isMember() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // 만 14세 확인을 마친 회원. 회원 기록을 쓰는 모든 규칙(2단계~)이 이걸 요구한다 —
    // 확인 화면을 건너뛰어도 기록이 쌓이지 않게 한다(15 문서 §3).
    function ageConfirmed() {
      return isMember()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('ageConfirmedAt', null) != null;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) && isMember();

      // 만 14세 확인 = 프로필 생성. 시각은 서버 시각(request.time)이어야 한다 —
      // 기기 시계로 지어낼 수 없다. 1단계에서는 이 두 필드만 받는다.
      allow create: if isOwner(uid) && isMember()
        && request.resource.data.keys().hasOnly(['ageConfirmedAt', 'createdAt'])
        && request.resource.data.ageConfirmedAt == request.time
        && request.resource.data.createdAt == request.time;

      // 확인 시각은 고칠 수 없다. 닉네임·최애 구단 같은 필드는 3단계에서 연다.
      allow update: if false;

      // 본인 탈퇴(만 14세 미만 응답 포함)
      allow delete: if isOwner(uid);
    }
  }
}
