{
  "name": "yaguking",
  "version": "0.1.0",
  "private": true,
  "description": "야구왕 (YaguKing) — KBO 기록 퀴즈를 1이닝 경기로 플레이하는 웹앱",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:sql": "node scripts/check-sql.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:lint": "supabase db lint",
    "seed:questions": "node scripts/seed-questions.mjs",
    "security:check": "node scripts/security-check.mjs",
    "load:smoke": "node scripts/load-smoke.mjs",
    "db:fingerprint": "node scripts/db-fingerprint.mjs",
    "content:check": "node scripts/content-check.mjs",
    "content:rebalance": "node scripts/rebalance-option-labels.mjs",
    "funnel": "node scripts/funnel-report.mjs",
    "privacy:purge": "node scripts/privacy-purge.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "libpg-query": "^18.1.5",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
