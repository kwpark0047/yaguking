# 야구왕(YaguKing) 환경 변수 예시
# 이 파일을 .env.local로 복사하고 실제 값으로 채우세요.

# ── 사이트 ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (로컬 Docker) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4aCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ── 데이터베이스 (직접 연결) ──────────────────────────────────────────
# 로컬 Docker: postgresql://postgres:postgres@localhost:54322/postgres
# 프로덕션: Supavisor 또는 직접 연결 URL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── 연결 풀 ────────────────────────────────────────────────────────────
# 기본값: 10. 100명 동시 접속 시 20~30 권장
DATABASE_POOL_MAX=20

# ── 게스트 토큰 시크릿 (32자 이상, 반드시 변경 필요) ──────────────────
# 프로덕션 배포 전 기본값에서 변경 필수
GUEST_TOKEN_SECRET=change-this-to-a-32-char-or-longer-secret-key

# ── 신뢰 프록시 수 ─────────────────────────────────────────────────────
# 프록시 구성에 따라 조정 (기본값: 1)
TRUSTED_PROXY_COUNT=1

# ── 레이트 리밋 (E2E 전용) ─────────────────────────────────────────────
# off로 설정 시 레이트 리밋 비활성화. 프로덕션에서는 설정하지 마세요.
# RATE_LIMIT=off
