# 야구왕 환경변수 예시 — 실제 값은 넣지 않는다. 복사해서 .env.local 로 사용.
# .env.local 은 .gitignore 에 있다. CI/배포는 플랫폼 시크릿으로만 주입한다.

# ── 클라이언트 노출 (공개) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 실제로 설정이 끝난 소셜 공급자만 적는다. 비워 두면 이메일 로그인만 노출한다.
# 설정되지 않은 버튼을 띄우면 누른 사람이 막다른 길에 빠진다 (08 문서 V04).
# 예: google,kakao
NEXT_PUBLIC_AUTH_PROVIDERS=

# ── 서버 전용 ────────────────────────────────────────────────────────────
# 아래 값에는 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# RLS를 우회하므로 src/server 경계 밖에서 사용 금지 (09 문서 §3.1).
SUPABASE_SERVICE_ROLE_KEY=

# Supavisor 트랜잭션 모드 풀러 연결 문자열.
# 타석 제출 트랜잭션에 사용한다. prepare=false 설정은 src/lib/db/sql.ts 에 있다.
DATABASE_URL=

# 커넥션 풀 상한. 미설정 시 5.
# 단일 장기 실행 서버에서는 동시 50세션 기준 20이 타석 제출 p95 목표를
# 충족했다(PERFORMANCE.md). **서버리스에서는 반대로 작게 유지해야 한다** —
# 인스턴스마다 큰 풀을 쥐면 DB 커넥션이 고갈된다.
DATABASE_POOL_MAX=

# 게스트 쿠키 HMAC 서명 키 (32바이트 이상 랜덤).
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GUEST_TOKEN_SECRET=
# 레이트 리밋의 요청자 주소 해시에도 같은 키를 쓴다. IP 원문은 저장하지 않는다.

# ── 레이트 리밋 (11 문서 §3) ─────────────────────────────────────────────
# x-forwarded-for 에 주소를 덧붙이는 신뢰 프록시의 수. 미설정 시 1.
# **배포 구성에 맞춰야 한다.** 틀리면 이렇게 깨진다.
#   너무 작으면: 앞단 프록시(CDN)의 주소를 사용자 주소로 착각한다. 모든
#                사용자가 몇 개 안 되는 CDN 주소로 묶여 정상 사용자가 429를 받는다.
#   너무 크면:   클라이언트가 직접 보낸 값까지 믿는다. 요청마다 값을 바꾸면
#                리밋이 무력해진다.
# 프록시 없이 앱을 직접 노출하면 헤더 전체를 클라이언트가 정하므로 막을 수 없다.
#   프록시 하나 (Vercel, 단일 nginx 등): 1
#   CDN 뒤에 로드밸런서: 2
TRUSTED_PROXY_COUNT=

# E2E 전용. 정확히 off 일 때만 리밋을 끈다. **운영에서는 비워 둔다.**
# 비워 두거나 오타가 나면 켜진 쪽으로 틀린다.
RATE_LIMIT=

# ── 검색 노출 (11 문서 §3) ──────────────────────────────────────────────
# 정확히 allow 일 때만 색인을 허용한다. 비워 두면 robots.txt 전면 차단 +
# noindex 메타. 소규모 노출 동안은 비워 둔다 — 검색 유입이 섞이면 퍼널
# 수치가 더러워진다.
SEARCH_INDEXING=

# ── 구단 테마 (08 문서 §2.5, 11 문서 §4) ────────────────────────────────
# 정확히 off 일 때만 구단 테마를 끈다. 끄면 모든 화면이 브랜드 기본색으로
# 돌아가고, 레벨 등급 테마는 그대로 남는다.
# 구단 색은 공식 브랜드 값이 아닌 자체 근사치이며 **권리 검토 전이다.**
# 검토 결과가 부정적이면 코드를 고치지 않고 이 값으로 끈다.
TEAM_THEMES=
